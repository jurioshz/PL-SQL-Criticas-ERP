SELECT DISTINCT X.SEQAUXNOTAFISCAL, X.NUMERONF, X.NROEMPRESA, 0 AS SEQAUXNFITEM,
'B' AS BLOQAUTOR, 119 AS CODINCONSISTENC, 
'A NF referenciada '||N.NUMERONF||' já foi lançada na empresa '||N.NROEMPRESA||'. Não é permitido matar a operação. Verifique!' AS MENSAGEM
FROM CONSINCO.MLF_AUXNOTAFISCAL X 
INNER JOIN CONSINCO.MLF_AUXNFITEM XI ON XI.SEQAUXNOTAFISCAL = X.SEQAUXNOTAFISCAL
INNER JOIN CONSINCO.MFL_DOCTOFISCAL R ON R.SEQNF = XI.SEQNFREF
INNER JOIN CONSINCO.MLF_NOTAFISCAL N ON N.NFECHAVEACESSO = R.NFECHAVEACESSO
WHERE X.CODGERALOPER = 69
AND X.DTAEMISSAO >= SYSDATE - 100
AND N.TIPNOTAFISCAL = 'E'                
AND N.STATUSNF != 'C'                   
AND N.NROEMPRESA != X.NROEMPRESA 
