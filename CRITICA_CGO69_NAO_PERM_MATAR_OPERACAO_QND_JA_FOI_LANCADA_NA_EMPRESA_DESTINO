SELECT DISTINCT X.SEQAUXNOTAFISCAL, X.NUMERONF, X.NROEMPRESA, 0 AS SEQAUXNFITEM, 'B' AS BLOQAUTOR, 119 AS CODINCONSISTENC, 
'A NF '||X.NFREFERENCIANRO||' já está lançada no sistema. Não é permitido matar a operação. Verifique a NF referenciada!' AS MENSAGEM
FROM CONSINCO.MLF_AUXNOTAFISCAL X
INNER JOIN CONSINCO.MLF_NOTAFISCAL Z ON Z.NUMERONF = X.NFREFERENCIANRO
AND Z.SERIENF = X.NFREFERENCIASERIE
AND Z.SEQPESSOA = X.SEQPESSOA
WHERE X.CODGERALOPER IN (69,135)
 AND X.NFREFERENCIANRO IS NOT NULL

