SELECT DISTINCT X.SEQAUXNOTAFISCAL, X.NUMERONF, X.NROEMPRESA, 0 AS SEQAUXNFITEM, 'B' AS BLOQAUTOR, 119 AS CODINCONSISTENC,
'A NF '||Z.NUMERODF|| ' já está lançada no sistema. Não é permitido matar a operação. Verifique a NF referenciada!' AS MENSAGEM
FROM CONSINCO.MLF_AUXNOTAFISCAL X
INNER JOIN CONSINCO.MLF_AUXNFITEM Y ON Y.SEQAUXNOTAFISCAL = X.SEQAUXNOTAFISCAL
INNER JOIN CONSINCO.MFL_DOCTOFISCAL Z ON Z.SEQNF = Y.SEQNFREF
WHERE X.CODGERALOPER = 69
AND Y.SEQNFREF IS NOT NULL
