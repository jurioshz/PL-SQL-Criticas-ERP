SELECT DISTINCT X.SEQAUXNOTAFISCAL, X.NUMERONF, X.NROEMPRESA, Y.SEQAUXNFITEM,
'B' AS BLOQAUTOR, 118 AS CODINCONSISTENC, 
'Item '||Y.SEQPRODUTO||' com finalidade '||FIN.DESCRICAO||' não permitido no CGO '||X.CODGERALOPER||'. Verifique!' AS MENSAGEM
FROM CONSINCO.MLF_AUXNOTAFISCAL X INNER JOIN CONSINCO.MLF_AUXNFITEM Y ON Y.SEQAUXNOTAFISCAL = X.SEQAUXNOTAFISCAL
INNER JOIN CONSINCO.MAP_PRODUTO C ON C.SEQPRODUTO = Y.SEQPRODUTO
INNER JOIN CONSINCO.MAP_FAMDIVISAO D ON D.SEQFAMILIA = C.SEQFAMILIA
INNER JOIN MAP_FINALIDADEFAMILIA FIN ON FIN.FINALIDADEFAMILIA = D.FINALIDADEFAMILIA
WHERE X.CODGERALOPER = 141
AND D.FINALIDADEFAMILIA = 'R'
