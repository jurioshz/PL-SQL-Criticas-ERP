SELECT DISTINCT A.SEQAUXNOTAFISCAL, A.NUMERONF, A.NROEMPRESA, 0 SEQAUXNFITEM, 'L' BLOQAUTOR,
124 CODINCONSISTENC, 'NF de origem não autorizada pela SEFAZ. Aguarde a autorizacao da NF original.' MENSAGEM
FROM CONSINCO.MLF_AUXNOTAFISCAL A
INNER JOIN CONSINCO.MFL_DOCTOFISCAL X ON X.SEQNF = A.SEQNFREF
WHERE A.SEQNFREF IS NOT NULL
AND X.NROEMPRESA = A.SEQPESSOA
AND NVL(X.STATUSNFE, 0) != 4
